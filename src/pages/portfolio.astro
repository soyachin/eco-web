---
/**
 * portfolio.astro — Galería interactiva de obras de arte.
 * Diseño libre, no corporativo. Usa Base.astro directamente.
 */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';

// Obras de arte del portafolio — editar aquí directamente
// Formato: { src, title, year, medium, description }
const artworks = [
  {
    src: 'https://via.placeholder.com/600x800/282828/d3869b?text=obra+01',
    title: 'obra 01',
    year: '2024',
    medium: 'digital',
    description: 'descripción breve de la obra.',
  },
  {
    src: 'https://via.placeholder.com/600x800/3c3836/8ec07c?text=obra+02',
    title: 'obra 02',
    year: '2024',
    medium: 'mixta',
    description: 'descripción breve de la obra.',
  },
  {
    src: 'https://via.placeholder.com/600x800/32302f/fabd2f?text=obra+03',
    title: 'obra 03',
    year: '2023',
    medium: 'óleo',
    description: 'descripción breve de la obra.',
  },
  {
    src: 'https://via.placeholder.com/600x800/282828/83a598?text=obra+04',
    title: 'obra 04',
    year: '2023',
    medium: 'acuarela',
    description: 'descripción breve de la obra.',
  },
];
---

<Base title="portafolio" description="Obras de arte de ecomecanico: ilustración, pintura y arte digital.">
  <Header />
  <main class="portfolio-main">

    <header class="portfolio-header">
      <h1 class="portfolio-title">portafolio</h1>
      <p class="portfolio-sub font-mono">obras · {artworks.length} piezas</p>
    </header>

    <!-- Galería masonry interactiva -->
    <div class="gallery" id="gallery">
      {artworks.map((work, i) => (
        <button
          class="gallery-item"
          data-index={i}
          onclick={`openLightbox(${i})`}
          aria-label={`Ver ${work.title}`}
        >
          <div class="gallery-img-wrap">
            <img src={work.src} alt={work.title} loading="lazy" class="gallery-img" />
            <div class="gallery-overlay">
              <span class="gallery-overlay-title">{work.title}</span>
              <span class="gallery-overlay-meta">{work.medium} · {work.year}</span>
            </div>
          </div>
        </button>
      ))}
    </div>

    <!-- Lightbox -->
    <div class="lightbox" id="lightbox" aria-hidden="true" role="dialog" aria-modal="true">
      <button class="lightbox-close" onclick="closeLightbox()" aria-label="Cerrar">&times;</button>
      <button class="lightbox-prev" onclick="prevArtwork()" aria-label="Anterior">&#8592;</button>
      <button class="lightbox-next" onclick="nextArtwork()" aria-label="Siguiente">&#8594;</button>

      <div class="lightbox-content">
        <img id="lightbox-img" src="" alt="" class="lightbox-img" />
        <div class="lightbox-info">
          <h2 id="lightbox-title" class="lightbox-title font-syne"></h2>
          <p id="lightbox-meta" class="lightbox-meta font-mono"></p>
          <p id="lightbox-desc" class="lightbox-desc"></p>
        </div>
      </div>
    </div>
    <div class="lightbox-backdrop" id="lightbox-backdrop" onclick="closeLightbox()"></div>
  </main>
</Base>

<script define:vars={{ artworks }}>
  let currentIndex = 0;

  function openLightbox(index) {
    currentIndex = index;
    updateLightbox();
    document.getElementById('lightbox').setAttribute('aria-hidden', 'false');
    document.getElementById('lightbox').classList.add('open');
    document.getElementById('lightbox-backdrop').classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    document.getElementById('lightbox').setAttribute('aria-hidden', 'true');
    document.getElementById('lightbox').classList.remove('open');
    document.getElementById('lightbox-backdrop').classList.remove('open');
    document.body.style.overflow = '';
  }

  function prevArtwork() {
    currentIndex = (currentIndex - 1 + artworks.length) % artworks.length;
    updateLightbox();
  }

  function nextArtwork() {
    currentIndex = (currentIndex + 1) % artworks.length;
    updateLightbox();
  }

  function updateLightbox() {
    const work = artworks[currentIndex];
    document.getElementById('lightbox-img').src = work.src;
    document.getElementById('lightbox-img').alt = work.title;
    document.getElementById('lightbox-title').textContent = work.title;
    document.getElementById('lightbox-meta').textContent = `${work.medium} · ${work.year}`;
    document.getElementById('lightbox-desc').textContent = work.description;
  }

  // Navegar con teclas
  document.addEventListener('keydown', e => {
    const lb = document.getElementById('lightbox');
    if (!lb.classList.contains('open')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') prevArtwork();
    if (e.key === 'ArrowRight') nextArtwork();
  });

  // Exponer funciones globalmente para los onclick inline
  window.openLightbox = openLightbox;
  window.closeLightbox = closeLightbox;
  window.prevArtwork = prevArtwork;
  window.nextArtwork = nextArtwork;
</script>

<style>
  .portfolio-main {
    max-width: var(--layout-max-width);
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .portfolio-header {
    margin-bottom: 3rem;
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
  }

  .portfolio-title {
    font-family: var(--font-syne);
    font-size: clamp(2.5rem, 6vw, 5rem);
    color: var(--brand-primary);
    font-weight: 700;
    line-height: 1;
  }

  .portfolio-sub {
    color: var(--fg-muted);
    font-size: 0.875rem;
  }

  /* Galería masonry con CSS columns */
  .gallery {
    columns: 1;
    gap: 1.25rem;
  }

  @media (min-width: 640px)  { .gallery { columns: 2; } }
  @media (min-width: 1024px) { .gallery { columns: 3; } }

  .gallery-item {
    break-inside: avoid;
    display: block;
    width: 100%;
    margin-bottom: 1.25rem;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
    text-align: left;
  }

  .gallery-img-wrap {
    position: relative;
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
  }

  .gallery-img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.5s ease, filter 0.3s ease;
    filter: saturate(0.85);
  }

  .gallery-item:hover .gallery-img {
    transform: scale(1.04);
    filter: saturate(1.1);
  }

  .gallery-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(40, 40, 40, 0.85) 0%, transparent 60%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.25rem;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .gallery-item:hover .gallery-overlay,
  .gallery-item:focus .gallery-overlay {
    opacity: 1;
  }

  .gallery-overlay-title {
    font-family: var(--font-syne);
    font-size: 1.1rem;
    color: var(--fg-primary);
    font-weight: 700;
  }

  .gallery-overlay-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--fg-muted);
    margin-top: 0.2rem;
  }

  /* Lightbox */
  .lightbox-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(10, 10, 10, 0.85);
    z-index: 200;
    backdrop-filter: blur(4px);
    &.open { display: block; }
  }

  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 210;
    align-items: center;
    justify-content: center;
    &.open { display: flex; }
  }

  .lightbox-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    max-height: 90vh;
    max-width: min(90vw, 800px);
    padding: 1rem;
  }

  @media (min-width: 768px) {
    .lightbox-content {
      flex-direction: row;
      align-items: flex-start;
    }
  }

  .lightbox-img {
    max-height: 75vh;
    max-width: 100%;
    object-fit: contain;
    border-radius: 0.75rem;
    box-shadow: 0 25px 60px rgba(0,0,0,0.7);
    flex-shrink: 0;
  }

  .lightbox-info {
    max-width: 280px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .lightbox-title {
    font-family: var(--font-syne);
    font-size: 1.75rem;
    color: var(--brand-primary);
    font-weight: 700;
  }

  .lightbox-meta {
    font-size: 0.8rem;
    color: var(--fg-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .lightbox-desc {
    font-size: 0.9rem;
    color: var(--fg-primary);
    line-height: 1.6;
    font-family: var(--font-main);
  }

  .lightbox-close {
    position: fixed;
    top: 1.5rem;
    right: 1.5rem;
    z-index: 220;
    background: color-mix(in srgb, var(--bg-secondary) 80%, transparent);
    border: 1px solid var(--border-subtle);
    color: var(--fg-primary);
    font-size: 1.5rem;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }

  .lightbox-close:hover { background: var(--bg-secondary); }

  .lightbox-prev, .lightbox-next {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    z-index: 220;
    background: color-mix(in srgb, var(--bg-secondary) 80%, transparent);
    border: 1px solid var(--border-subtle);
    color: var(--fg-primary);
    font-size: 1.25rem;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
  }

  .lightbox-prev { left: 1rem; }
  .lightbox-next { right: 1rem; }
  .lightbox-prev:hover, .lightbox-next:hover { background: var(--bg-secondary); }
</style>
