---
/**
 * index.astro — Homepage. Lista las notas más recientes.
 * Permite filtrar por tag via query param ?tag=xxx.
 */
import ThreeColumn from '../layouts/ThreeColumn.astro';
import { getCollection } from 'astro:content';
import { buildBacklinksMap } from '../lib/backlinks';
import { generateSnippet, sortNotesByDateDesc } from '../lib/utils';
import { formatDate } from '../lib/utils';
import type { Note } from '../lib/types';

// Obtener todas las notas publicadas
const entries = await getCollection('blog', ({ data }) => !data.draft);
const backlinksMap = await buildBacklinksMap();

// Construir el array de Note para el grafo y link preview
import fs from 'node:fs/promises';
import path from 'node:path';

const notes: Note[] = await Promise.all(entries.map(async e => {
  const filePath = path.join(process.cwd(), 'src/content/blog', `${e.id}.mdx`);
  let body = '';
  try { body = await fs.readFile(filePath, 'utf-8'); }
  catch { try { body = await fs.readFile(filePath.replace('.mdx', '.md'), 'utf-8'); } catch { } }

  return {
    slug: e.id,
    snippet: generateSnippet(body),
    meta: {
      title: e.data.title,
      tags: e.data.tags,
      date: e.data.date ? String(e.data.date) : undefined,
    },
  };
}));

// Filtrar por tag si viene en la query string (solo aplica en client, el build es estático)
const sortedNotes = sortNotesByDateDesc(notes);
---

<ThreeColumn
  title="ecomecanico"
  description="Blog de tecnología, arte y software libre."
  {notes}
  {backlinksMap}
>
  <h1 class="text-5xl font-syne font-bold mb-10 text-brand tracking-tight">
    recent notes
  </h1>


  <ul class="flex flex-col gap-8 list-none p-0">
    {sortedNotes.slice(0, 10).map(note => (
      <li class="group">
        <div class="flex flex-col gap-1">
          <a href={`/${note.slug}`} class="block no-underline">
            <h2 class="text-xl font-semibold text-foreground group-hover:text-brand transition-colors duration-200">
              {note.meta?.title ?? note.slug}
            </h2>
          </a>
          <div class="flex items-center gap-4 font-mono text-sm text-muted">
            <span class="opacity-70">{formatDate(note.meta?.date) || '??/??/????'}</span>
            <div class="flex gap-2">
              {(note.meta?.tags ?? []).map(tag => (
                <a
                  href={`/tags/${tag}`}
                  class="text-muted hover:text-accent transition-colors no-underline"
                >
                  #{tag}
                </a>
              ))}
            </div>
          </div>
        </div>
      </li>
    ))}
    {sortedNotes.length === 0 && (
      <p class="text-muted font-mono opacity-50">ls: no hay notas</p>
    )}
  </ul>
</ThreeColumn>
