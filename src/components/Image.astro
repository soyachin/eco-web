---
/**
 * Image.astro — Componente de imagen flexible con caption, zoom y loading.
 * Versión Astro fiel al Image.svelte original.
 *
 * Para que object-fit funcione, la imagen necesita una caja con altura
 * definida. Eso se logra con `height` explícito O con `aspectRatio`.
 * Sin ninguno de los dos, la imagen fluye en altura natural (h-auto).
 */
interface Props {
  src: string;
  alt?: string;
  caption?: string;
  width?: string;
  height?: string;
  /** Ej: "16/9", "4/3", "1/1". Tiene prioridad sobre height para el aspecto. */
  aspectRatio?: string;
  fit?: 'cover' | 'contain' | 'fill' | 'scale-down' | 'none';
  position?: string;
  align?: 'left' | 'center' | 'right';
  rounded?: 'none' | 'sm' | 'md' | 'lg' | 'xl' | '2xl' | '3xl' | 'full';
  shadow?: 'none' | 'sm' | 'md' | 'lg' | 'xl' | '2xl';
  zoom?: boolean;
  class?: string;
}

const {
  src,
  alt = '',
  caption = '',
  width = '100%',
  height = 'auto',
  aspectRatio = 'auto',
  fit = 'cover',
  position = 'center',
  align = 'center',
  rounded = 'xl',
  shadow = 'md',
  zoom = true,
  class: className = '',
} = Astro.props;

// Alineación del figure
const alignClass: Record<string, string> = {
  left:   'items-start ml-0 mr-auto',
  center: 'items-center mx-auto',
  right:  'items-end ml-auto mr-0',
};

// Border radius — igual que el mapa borderRadius de $lib/styles
const roundedClass: Record<string, string> = {
  none: 'rounded-none',
  sm:   'rounded-sm',
  md:   'rounded-md',
  lg:   'rounded-lg',
  xl:   'rounded-xl',
  '2xl':'rounded-2xl',
  '3xl':'rounded-3xl',
  full: 'rounded-full',
};

// Box shadow
const shadowClass: Record<string, string> = {
  none: 'shadow-none',
  sm:   'shadow-sm',
  md:   'shadow-md',
  lg:   'shadow-lg',
  xl:   'shadow-xl',
  '2xl':'shadow-2xl',
};

// La imagen necesita ser absolute+inset-0 cuando hay una caja con altura fija
// (sea por height explícito o por aspect-ratio). En ese caso el <div> es el
// contenedor contra el que object-fit recorta.
const hasBoundedBox = height !== 'auto' || aspectRatio !== 'auto';

// Estilos inline del contenedor: height y/o aspect-ratio
const containerStyle = [
  height !== 'auto' ? `height: ${height};` : '',
  aspectRatio !== 'auto' ? `aspect-ratio: ${aspectRatio};` : '',
].filter(Boolean).join(' ');
---

<figure
  class={`not-prose my-10 flex flex-col ${alignClass[align] ?? 'items-center mx-auto'} ${className}`}
  style={width !== '100%' ? `width: ${width}; max-width: 100%;` : 'max-width: 100%;'}
>
  <div
    class={`relative w-full overflow-hidden border border-white/10 bg-black/5 ${roundedClass[rounded] ?? 'rounded-xl'} ${shadowClass[shadow] ?? 'shadow-md'} group`}
    style={containerStyle || undefined}
  >
    <img
      src={src}
      alt={alt}
      class={[
        'block w-full m-0 p-0 transition-transform duration-700 ease-out',
        zoom ? 'group-hover:scale-110' : '',
        // Cuando hay caja acotada: absolute para que object-fit tenga efecto
        hasBoundedBox ? 'absolute inset-0 h-full' : 'relative h-auto',
      ].join(' ')}
      style={`object-fit: ${fit}; object-position: ${position};`}
      loading="lazy"
    />

    <!-- Overlay sutil al hacer hover -->
    <div class="absolute inset-0 bg-black/0 group-hover:bg-black/5 transition-colors duration-300 pointer-events-none" />
  </div>

  { caption &&
    <figcaption class="mt-3 text-center text-[11px] font-mono text-muted tracking-widest uppercase">
      {caption}
    </figcaption>
  }
</figure>

<style>
  /* Evita que el figure se aplaste dentro de grids o flex containers */
  figure {
    min-width: 0;
  }
</style>