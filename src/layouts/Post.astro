---
/**
 * Post.astro — Layout para notas/posts individuales.
 * Wrappea ThreeColumn y agrega el header de la nota (título, fecha, tags).
 */
import ThreeColumn from './ThreeColumn.astro';
import { formatDate } from '../lib/utils';
import type { Note, Backlink } from '../lib/types';

interface Props {
  title: string;
  date?: Date | string;
  tags?: string[];
  description?: string;
  slug: string;
  notes: Note[];
  backlinksMap: Record<string, Backlink[]>;
}

const { title, date, tags = [], description, slug, notes, backlinksMap } = Astro.props;
---

<ThreeColumn
  {title}
  {description}
  {slug}
  {notes}
  {backlinksMap}
  isNotePage={true}
>
  <article class="prose max-w-none">
    <header class="not-prose border-b border-border-subtle/10 text-left pb-2 mb-8">
      <h1 id="title" class="text-5xl font-bold text-brand mb-2 leading-tight">
        {title}
      </h1>
      <div class="flex flex-col items-start gap-2 font-mono text-base text-muted">
        {date && <span class="opacity-70">{formatDate(date)}</span>}
        <div class="flex flex-wrap gap-4">
          {tags.map(tag => (
            <a href={`/tags/${tag}`} class="text-muted hover:text-brand transition-colors no-underline">
              #{tag}
            </a>
          ))}
        </div>
      </div>
    </header>

    <slot />
  </article>
</ThreeColumn>
