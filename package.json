{
	"name": "mypage",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "pnpm generate && vite dev",
		"build": "pnpm generate && vite build",
		"preview": "vite preview",
		"generate": "node scripts/generate-notes.js",
		"prepare": "pnpm generate && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "pnpm run test:unit && pnpm run test:e2e",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:e2e": "playwright test",
		"test:ui": "vitest --ui"
	},
	"devDependencies": {
		"@playwright/test": "^1.58.2",
		"@sveltejs/adapter-node": "^5.2.12",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.1",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@vitest/ui": "^4.0.18",
		"autoprefixer": "^10.4.27",
		"jsdom": "^28.1.0",
		"mdsvex": "^0.12.6",
		"rehype-sanitize": "^5.0.1",
		"remark-callouts": "^2.0.0",
		"remark-gfm": "^3.0.1",
		"remark-wiki-link": "^1.0.0",
		"svelte": "^5.53.6",
		"svelte-check": "^4.3.6",
		"tailwindcss": "^4.2.1",
		"typescript": "^5.9.3",
		"unist-util-visit": "^2.0.3",
		"vite": "^7.3.1",
		"vitest": "^4.0.18",
		"vitest-svelte-kit": "^0.0.7"
	},
	"dependencies": {
		"@types/d3": "^7.4.3",
		"d3": "^7.9.0",
		"flexsearch": "^0.8.212",
		"gray-matter": "^4.0.3",
		"lucide-svelte": "^0.576.0",
		"prettier": "^3.8.1"
	}
}